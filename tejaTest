@TeleOp(name = "3ballsTest")
public class 3ballsTest extends LinearOpMode {
  /*
  Configuration:

  Control Hub

  Servo - Port 0 - Gate
  Motors:
  REV Robotics Core Hex Motor - Port 1 - RightFlap
  REV Robotics Core Hex Motor - Port 2 - intake1
  REV Robotics UltraPlanetary HD Hex Motor - Port 0 - flywheelv1

  ExpansionHub 2:
  Motors:
  GoBilda5202/3/4 - Port 0 - BackRight
  GoBilda5202/3/4 - Port 1 - FrontRight
  GoBilda5202/3/4 - Port 2 - FrontLeft
  GoBilda5202/3/4 - Port 3 - BackLeft
  

  */
  
    boolean USE_WEBCAM;
    AprilTagProcessor myAprilTagProcessor;
    VisionPortal myVisionPortal;

    private DcMotor frontLeft;
    private DcMotor backLeft;
    private DcMotor frontRight;
    private DcMotor backRight;
    private DcMotor flyWheel;
    private DcMotor intake1;
    private DcMotor rightFlap;
    private Servo gate;
    
    
    private boolean servoAtPosition1 = false;
    private boolean prevButtonState = false;
    private boolean prevButtonState2 = false;
    private boolean flyWheelOff = true;
    private final double POSITION_ONE = 1;
    private final double POSITION_TWO = 0;


    /**
     * This function is executed when this Op Mode is selected from the Driver Station.
     */
    @Override
    public void runOpMode() {
        // Variable definition and hardwre initialization.
        float vertical;
        float horizontol;
        float pivot;
        double frontRight2;
        double backRight2;
        double frontLeft2;
        double backLeft2;



        frontLeft = hardwareMap.get(DcMotor.class, "FrontLeft");
        backLeft = hardwareMap.get(DcMotor.class, "BackLeft");
        frontRight = hardwareMap.get(DcMotor.class, "FrontRight");
        backRight = hardwareMap.get(DcMotor.class, "BackRight");
        
        flyWheel = hardwareMap.get(DcMotor.class, "flywheelv1");
        intake1 = hardwareMap.get(DcMotor.class, "intake1");
        rightFlap = hardwareMap.get(DcMotor.class, "RightFlap");
        gate = hardwareMap.get(Servo.class, "Gate");
        
        flyWheel.setMode(DcMotor.RunMode.RUN_USING_ENCODER);
        frontRight.setDirection(DcMotor.Direction.REVERSE);
        backRight.setDirection(DcMotor.Direction.REVERSE);

        gate.setPosition(POSITION_TWO);
        servoAtPosition1 = true;

        waitForStart();
        if (opModeIsActive()) {
            // Put run blocks here.
            while (opModeIsActive()) {

                //Drivetrain code
                vertical = gamepad1.right_stick_y;
                horizontol = -gamepad1.right_stick_x;
                pivot = -gamepad1.left_stick_x;
                frontRight2 = 0.8 * (-pivot + (vertical - horizontol));
                backRight2 = 0.8 * (-pivot + vertical + horizontol);
                frontLeft2 = 0.8 * (pivot + vertical + horizontol);
                backLeft2 = 0.8 * (pivot + (vertical - horizontol));
                telemetry.addData("FrontRight", Double.parseDouble(JavaUtil.formatNumber(frontRight2, 1)));
                telemetry.addData("BackRight", Double.parseDouble(JavaUtil.formatNumber(backRight2, 1)));
                telemetry.addData("FrontLeft", Double.parseDouble(JavaUtil.formatNumber(frontLeft2, 1)));
                telemetry.addData("BackLeft", Double.parseDouble(JavaUtil.formatNumber(backLeft2, 1)));
                telemetry.update();
                frontRight.setPower(frontRight2);
                backRight.setPower(backRight2);
                frontLeft.setPower(frontLeft2);
                backLeft.setPower(backLeft2);


                // telemetry.addData("GamePadLeftBumper", gamepad1.left_bumper);
                // telemetry.addData("prevButtonState2", prevButtonState2);
                // telemetry.addData("flyWheelOff", flyWheelOff);

                // telemetry.addData("Flywheel Velocity 1", ((DcMotorEx) flyWheel).getVelocity());
                // telemetry.addData("Flywheel Power 1", flyWheel.getPower());
                // telemetry.update();                

                // telemetry.update();
                if (gamepad1.left_bumper && !prevButtonState2) {
                    if (flyWheelOff) {
                        // flyWheel.setPower(.72);
                        ((DcMotorEx) flyWheel).setVelocity(1600);
                        flyWheelOff = false;
                    } else {
                        // flyWheel.setPower(0);
                        ((DcMotorEx) flyWheel).setVelocity(0);
                        flyWheelOff = true;
                    }
                    sleep(200); //what does sleep do here?
                }
                // if (flyWheel.velocity <= 1550 ){
                //     gate.setPosition(POSITION_TWO);
                // }
                    
                
                prevButtonState2 = gamepad1.left_bumper;

                if (gamepad1.y) {
                    intake1.setPower(-1);
                    rightFlap.setPower(1);
                } else {
                    intake1.setPower(0);
                    rightFlap.setPower(0);
                }

                if (gamepad1.a) {
                    intake1.setPower(1);

                } else {
                    intake1.setPower(0);

                }

                if (gamepad1.a || gamepad1.b) {
                    rightFlap.setPower(-1);

                } else {
                    rightFlap.setPower(0);

                }
                if (gamepad1.dpad_left && !prevButtonState) {
                    if (servoAtPosition1) {
                        gate.setPosition(POSITION_TWO);
                        servoAtPosition1 = false;
                    } else {
                        gate.setPosition(POSITION_ONE);
                        servoAtPosition1 = true;
                    }

                    sleep(200);
                }

                prevButtonState = gamepad1.dpad_left;
            }
        }
    }
}
